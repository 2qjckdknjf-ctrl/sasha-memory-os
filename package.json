{
  "name": "sasha-memory-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test && vitest run --config vitest.workspace.config.ts",
    "lint": "eslint --max-warnings=0 .",
    "dev:api": "pnpm --filter @memory-os/api dev",
    "dev:web": "pnpm --filter @memory-os/web dev"
  },
  "devDependencies": {
    "@memory-os/authz": "workspace:^",
    "@memory-os/domain": "workspace:^",
    "@memory-os/retrieval": "workspace:^",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "eslint": "10.12.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.15",
      "source-map-js": "1.2.2",
      "uuid": "11.1.1",
      "vitest>tinypool": "2.1.2"
    }
  }
}
