# Copy to .env for local use. Never commit real service_role values.
# See docs/engineering/SECRETS_POLICY.md and docs/engineering/SUPABASE.md

MEMORY_OS_ENV=local

# Dedicated Memory OS project (eu-central-1) — not AISTROYKA/HiAir
MEMORY_OS_SUPABASE_URL=https://vpxblcxsvlylqyldiuwr.supabase.co
MEMORY_OS_SUPABASE_ANON_KEY=
MEMORY_OS_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to Web/PWA/companion
MEMORY_OS_SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for public.api_* RPCs (server-side only; never ship to browser)
MEMORY_OS_API_SECRET=

MEMORY_OS_PROJECT_REF=vpxblcxsvlylqyldiuwr
VITE_MEMORY_API_URL=http://localhost:8787

# Real OAuth: CLIENT_ID → authorize URL; + CLIENT_SECRET → credentials_ready exchange mode
# (tokens still never land in Postgres — vault ref + code fingerprint only)
# MEMORY_OS_OAUTH_GITHUB_CLIENT_ID=
# MEMORY_OS_OAUTH_GITHUB_CLIENT_SECRET=
# MEMORY_OS_OAUTH_GOOGLE_CLIENT_ID=
# MEMORY_OS_OAUTH_GOOGLE_CLIENT_SECRET=
# Optional overrides (defaults used when CLIENT_ID is set):
# MEMORY_OS_OAUTH_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# MEMORY_OS_OAUTH_GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth

# OCR: stub | fixture | tesseract (system CLI)
MEMORY_OS_OCR_ENGINE=stub

