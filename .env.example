# Copy to .env for local use. Never commit real service_role values.
# See docs/engineering/SECRETS_POLICY.md and docs/engineering/SUPABASE.md

MEMORY_OS_ENV=local

# Require x-memory-os-api-secret / Bearer on owner ops routes (auto on outside local/test)
# MEMORY_OS_REQUIRE_API_AUTH=1

# Comma-separated browser origins for API CORS (defaults to localhost:5173)
# MEMORY_OS_CORS_ORIGINS=http://localhost:5173,https://your-web.example

# Dedicated Memory OS project (eu-central-1) — not AISTROYKA/HiAir
MEMORY_OS_SUPABASE_URL=https://vpxblcxsvlylqyldiuwr.supabase.co
MEMORY_OS_SUPABASE_ANON_KEY=
MEMORY_OS_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to Web/PWA/companion
MEMORY_OS_SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for public.api_* RPCs (server-side only; never ship to browser)
MEMORY_OS_API_SECRET=

MEMORY_OS_PROJECT_REF=vpxblcxsvlylqyldiuwr
VITE_MEMORY_API_URL=http://localhost:8787

# Real OAuth: CLIENT_ID → authorize URL; + CLIENT_SECRET → HTTP token exchange into vault
# (tokens never land in Postgres — vault ref + code fingerprint only)
# MEMORY_OS_OAUTH_GITHUB_CLIENT_ID=
# MEMORY_OS_OAUTH_GITHUB_CLIENT_SECRET=
# MEMORY_OS_OAUTH_GOOGLE_CLIENT_ID=
# MEMORY_OS_OAUTH_GOOGLE_CLIENT_SECRET=
# Required for Google token exchange when redirect_uri was not stored on oauth_states:
# MEMORY_OS_OAUTH_REDIRECT_URI=http://localhost:8787/v1/oauth/callback
# Optional overrides (defaults used when CLIENT_ID is set):
# MEMORY_OS_OAUTH_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# MEMORY_OS_OAUTH_GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# MEMORY_OS_OAUTH_TOKEN_URL=

# Connector token vault: supabase (DB ciphertext) | supabase_vault (KMS) | local | memory
# Staging/prod recommendation: supabase_vault (managed KMS via supabase_vault extension)
# MEMORY_OS_VAULT_BACKEND=supabase_vault
# MEMORY_OS_VAULT_BACKEND=supabase


# MEMORY_OS_VAULT_DIR=.data/vault
# Required outside local/test (do not reuse API secret in prod):
# MEMORY_OS_VAULT_KEY=
# MEMORY_OS_VAULT_ALLOW_API_SECRET_FALLBACK=1

# Connector pull: auto (vault token if present else stub) | stub | vault
MEMORY_OS_CONNECTOR_PULL_MODE=auto
# Fail instead of silent stub fallback when vault token missing under auto:
# MEMORY_OS_CONNECTOR_PULL_STRICT=1

# OCR: stub | fixture | tesseract (system CLI)
MEMORY_OS_OCR_ENGINE=stub

# Audio transcription: stub | fixture | openai (Whisper; falls back to stub without key)
MEMORY_OS_TRANSCRIBE_ENGINE=stub
# MEMORY_OS_TRANSCRIBE_MODEL=whisper-1
# MEMORY_OS_TRANSCRIBE_STRICT=1

# Memory extraction LLM: stub | fixture | openai (falls back to stub without key)
MEMORY_OS_EXTRACT_ENGINE=stub
# MEMORY_OS_EXTRACT_MODEL=gpt-4o-mini
# MEMORY_OS_EXTRACT_STRICT=1

# Embeddings: stub (hash) | noop | openai (falls back to stub without key)
MEMORY_OS_EMBED_ENGINE=stub
# MEMORY_OS_OPENAI_API_KEY=
# MEMORY_OS_OPENAI_EMBED_MODEL=text-embedding-3-small
# OpenAI dims: 32 (alpha stub column) or 1536 (embedding_vector_hq HNSW)
# MEMORY_OS_OPENAI_EMBED_DIMS=32
# MEMORY_OS_OPENAI_EMBED_DIMS=1536

# Fail instead of silent stub fallback when openai key missing:
# MEMORY_OS_EMBED_STRICT=1
# MEMORY_OS_OPENAI_BASE_URL=https://api.openai.com/v1

# Worker cron loop (ms). Unset = one-shot CLI tick.
# MEMORY_OS_WORKER_INTERVAL_MS=60000
# MEMORY_OS_JOB_STALE_MINUTES=60
# MEMORY_OS_WORKSPACE_ID=11111111-1111-4111-8111-111111111111
# MEMORY_OS_OWNER_SUBJECT_ID=33333333-3333-4333-8333-333333333301

